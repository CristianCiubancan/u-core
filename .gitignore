# ───────── Environment & secrets ─────────
.env
.env.local
*.local

# ───────── Working scratch ─────────
# `tmp/` is for one-off scratch work — upstream resource clones we
# pull in for diffing during a port (e.g. `git clone qbcore-framework/qb-core
# tmp/qb-core-upstream` for the function-by-function audit), test
# fixtures, draft scripts. Anything inside is intentionally
# ephemeral and re-creatable, never the source of truth.
tmp/

# ───────── Build output ─────────
dist/
dist-ssr/
.vite/
.turbo/
*.tsbuildinfo

# ───────── Caches ─────────
.cache/
.eslintcache
.parcel-cache/

# ───────── Dependencies ─────────
node_modules/

# This repo is pnpm at the root; the asset-server sub-package uses npm
# (see CLAUDE.md). Ignore foreign root lockfiles plus the npm sentinel
# some tools drop. asset-server/package-lock.json is intentionally ignored
# under the same pattern — re-add a `!asset-server/package-lock.json`
# negation if you decide to track it for reproducible asset-server builds.
yarn.lock
package-lock.json
.yarn.installed

# ───────── Logs ─────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ───────── OS files ─────────
.DS_Store
Thumbs.db

# ───────── Editors / IDEs ─────────
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# ───────── Testing ─────────
coverage/
*.lcov

# ───────── Temporary files ─────────
*.tmp

# ───────── FXServer artifacts ─────────
# Local extraction dir (Windows host) and the source archives the Docker
# build downloads. Keep both forms — the upstream URL has shipped as
# .zip historically and as .tar.xz currently.
fivem-binaries/
fivem.zip
fx.tar.xz

# ───────── txData (FXServer runtime state) ─────────
# Entire runtime tree is generated by the txAdmin recipe (see txadmin/).
txData/

# ───────── asset-server ─────────
# Bulk image trees; only source files are tracked.
asset-server/public/*
asset-server/original/*

# ───────── Project-local agent settings ─────────
**/.claude/settings.local.json

# Screenshots dropped into the working tree for issue reports.
Screenshot*.png
image.png
image*.png
*.screenshot.png

upstream-reference