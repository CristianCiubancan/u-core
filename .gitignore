# ───────── Environment & secrets ─────────
.env
.env.local
*.local

# ───────── Build output ─────────
dist/
dist-ssr/
.vite/
.turbo/
*.tsbuildinfo

# ───────── Caches ─────────
.cache/
.eslintcache
.parcel-cache/

# ───────── Dependencies ─────────
node_modules/

# This repo is pnpm at the root; the asset-server sub-package uses npm
# (see CLAUDE.md). Ignore foreign root lockfiles plus the npm sentinel
# some tools drop. asset-server/package-lock.json is intentionally ignored
# under the same pattern — re-add a `!asset-server/package-lock.json`
# negation if you decide to track it for reproducible asset-server builds.
yarn.lock
package-lock.json
.yarn.installed

# ───────── Logs ─────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ───────── OS files ─────────
.DS_Store
Thumbs.db

# ───────── Editors / IDEs ─────────
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# ───────── Testing ─────────
coverage/
*.lcov

# ───────── Temporary files ─────────
*.tmp

# ───────── FXServer artifacts ─────────
# Local extraction dir (Windows host) and the source archives the Docker
# build downloads. Keep both forms — the upstream URL has shipped as
# .zip historically and as .tar.xz currently.
fivem-binaries/
fivem.zip
fx.tar.xz

# ───────── txData (FXServer runtime state) ─────────
# Pattern uses `txData/*` (not `txData/`) so the negation below can
# re-include a single tracked path — git can't undo a directory-level
# ignore.
txData/*
!txData/server.cfg.example

# ───────── asset-server ─────────
# Bulk image trees; only source files are tracked.
asset-server/public/*
asset-server/original/*

# ───────── Project-local agent settings ─────────
**/.claude/settings.local.json
