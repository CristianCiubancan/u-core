{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.webview.tsbuildinfo",
    "target": "ES2017",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "node",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "esModuleInterop": true,

    /* Type whitelist — without this, every package under typeRoots loads
       globally (notably @types/node, which leaks process/Buffer/setImmediate
       into NUI/browser code). Vite's `define` for ASSET_SERVER_URL is the
       only thing that keeps the current process.env access working at
       runtime; an explicit whitelist makes that contract enforceable. */
    "types": ["vite/client", "react", "react-dom"],

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "src/webview/**/*",
    "src/plugins/**/html/**/*"
  ],
  "references": [{ "path": "./tsconfig.plugins.shared.json" }]
}
