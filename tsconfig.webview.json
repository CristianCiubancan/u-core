{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.webview.tsbuildinfo",
    "target": "ES2017",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "esModuleInterop": true,

    /* Type whitelist — without this, every package under typeRoots loads
       globally (notably @types/node, which leaks process/Buffer/setImmediate
       into NUI/browser code). NUI runs in CEF/Chromium, not Node, so we
       expose only `vite/client` (for `import.meta.env`) and React. */
    "types": ["vite/client", "react", "react-dom"],

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    /* shadcn-style path alias. `@/` resolves to src/webview so that
       components written against the upstream shadcn templates can use
       `@/components/ui/...` and `@/lib/utils` import paths verbatim.
       baseUrl is intentionally omitted — TS 4.1+ resolves `paths`
       relative to this tsconfig's directory, and baseUrl is being
       deprecated in TS 6/7. */
    "paths": {
      "@/*": ["./src/webview/*"]
    }
  },
  "include": [
    "src/webview/**/*",
    "src/plugins/**/html/**/*"
  ],
  "references": [{ "path": "./tsconfig.plugins.shared.json" }]
}
