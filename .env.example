# Server configuration
# Required. The build pipeline writes resources into txData/${SERVER_NAME}/...
# Refuses to start if left as <replace-me>.
SERVER_NAME=<replace-me>

# API key for the reload manager to connect to FiveM.
# Required for `pnpm dev` watch mode AND for the in-game core resource to
# accept reload requests. The in-game server refuses to start if this is
# unset, empty, or left as <replace-me>. Generate with e.g.
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
RELOADER_API_KEY=<replace-me>

# Host where the FiveM server is running (default: localhost)
RELOADER_HOST=localhost

# Port for connecting to the FiveM server's reload API (default: 3414)
RELOADER_PORT=3414

# Whether to use HTTPS instead of HTTP (default: false)
RELOADER_USE_HTTPS=false

# Debounce times (in milliseconds)
DEBOUNCE_TIME=1000
RESOURCE_DEBOUNCE_TIME=3000
WEBVIEW_DEBOUNCE_TIME=1500

# Database configuration.
# MYSQL_USER must NOT be `root`. Create a dedicated unprivileged user.
# All four values are read by docker-compose at container build time.
MYSQL_ROOT_PASSWORD=<replace-me>
MYSQL_DATABASE=fivem
MYSQL_USER=fivem
MYSQL_PASSWORD=<replace-me>

# FXServer binaries archive. The Dockerfile uses this same URL by default;
# bump both together when upgrading FXServer.
BINARIES_ARCHIVE_URL=https://runtime.fivem.net/artifacts/fivem/build_proot_linux/master/25770-8ddccd4e4dfd6a760ce18651656463f961cc4761/fx.tar.xz
