{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.plugins.shared.tsbuildinfo",
    "outDir": "./node_modules/.tmp/typecheck/plugins.shared",
    "declaration": true,
    "module": "es2022",
    "target": "es2022",
    "lib": ["es2022"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strictFunctionTypes": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/plugins/**/shared/**/*"]
}
