{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PluginManifest",
  "description": "plugin.json schema. The TypeScript counterpart in src/scripts/types/Manifest.ts mirrors this file 1:1.",
  "type": "object",
  "required": ["name", "version", "fx_version"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Resource name. Emitted as `name 'X'` in fxmanifest.lua."
    },
    "version": {
      "type": "string",
      "description": "Plugin semantic version (e.g. 1.0.0)."
    },
    "fx_version": {
      "type": "string",
      "description": "FXv2 resource version channel.",
      "enum": ["cerulean", "bodacious", "adamant"]
    },
    "games": {
      "type": "array",
      "items": { "type": "string", "enum": ["gta5", "rdr3"] }
    },
    "author": { "type": "string" },
    "description": { "type": "string" },
    "client_scripts": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "server_scripts": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "shared_scripts": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "exports": { "type": "array", "items": { "type": "string" } },
    "server_exports": { "type": "array", "items": { "type": "string" } },
    "ui_page": { "type": "string" },
    "data_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "files"],
        "properties": {
          "type": { "type": "string" },
          "files": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "string" } }
            ]
          }
        }
      }
    },
    "is_map": { "type": "boolean" },
    "server_only": { "type": "boolean" },
    "loadscreen": { "type": "string" },
    "loadscreen_manual_shutdown": { "type": "boolean" },
    "files": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "lua54": { "type": "boolean" },
    "provide": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "constraints": {
      "type": "object",
      "properties": {
        "server": { "type": "string" },
        "policy": { "type": "array", "items": { "type": "string" } },
        "onesync": { "type": "boolean" },
        "gameBuild": { "type": "string" },
        "natives": { "type": "array", "items": { "type": "string" } }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "type": "number" },
          { "type": "boolean" }
        ]
      }
    }
  }
}
