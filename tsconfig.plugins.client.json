{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.plugins.client.tsbuildinfo",
    "noEmit": true,
    "module": "es2022",
    "target": "es2022",
    "lib": ["es2022"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strictFunctionTypes": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "types": ["@citizenfx/client"]
  },
  "include": ["src/plugins/**/client/**/*"],
  "exclude": [
    "src/plugins/**/html/**/*",
    "src/plugins/**/server/**/*",
    "src/plugins/**/shared/**/*"
  ],
  "references": [{ "path": "./tsconfig.plugins.shared.json" }]
}
